# For local testing without a Turso account, leave TURSO_* unset — the app
# will automatically use a local file database instead (db/vkg_gate.local.db).

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_DEFAULT_PASSWORD=ChangeMe@123

# Only used when running locally via `npm start` (ignored on Netlify)
PORT=3000
