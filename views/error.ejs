<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-page" style="background:var(--gray-50);">
    <div class="auth-card" style="text-align:center; box-shadow:var(--shadow);">
      <div class="auth-logo" style="justify-content:center; display:flex;">VKG<span>.</span></div>
      <h1 style="font-size:18px; color:var(--navy-900); margin:18px 0 8px;"><%= title %></h1>
      <p style="color:var(--gray-600); font-size:13.5px; margin-bottom:20px;"><%= message %></p>
      <a class="btn btn-navy" href="/">Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
